<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/card_bg"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_phone_title"
        android:textColor="@color/accent_gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/login_phone_subtitle"
        android:textColor="@color/label_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/phoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/input_bg"
        android:hint="@string/login_phone_hint"
        android:textColorHint="@color/label_muted"
        android:textColor="@color/text_title"
        android:inputType="phone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp" />

    <TextView
        android:id="@+id/phoneError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/error_red"
        android:textSize="12sp"
        android:visibility="gone" />

    <android.widget.Button
        android:id="@+id/phoneSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/primary_button_bg"
        android:text="@string/login_continue"
        android:textAllCaps="false"
        android:textColor="#2A1B04"
        android:textStyle="bold" />

</LinearLayout>
